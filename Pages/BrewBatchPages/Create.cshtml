@page
@model HOPS.Pages.BrewBatchPages.CreateModel
@using HOPS.Models
@using HOPS.Properties

@{
    ViewData["Title"] = @Resource.NewBatch;
}

<form method="post">
    <input type="hidden" asp-for="BrewBatch.BrewRecipeVersionId" />
    <input type="hidden" asp-for="BrewBatch.BottlingVolume" />
    <input type="hidden" asp-for="BrewBatch.BottlingTemperature" />

    <div asp-validation-summary="ModelOnly" class="text-danger validation-message"></div>

    <header class="recipe-header">
        <div class="recipe-title-row">
            <span class="recipename">@Model.BrewRecipe.Name</span>

            <div class="d-flex align-items-center gap-3">
                <span class="text-muted">v@(Model.BrewRecipeVersion.Version)</span>
            </div>
        </div>
    </header>

    <div id="batchDetails" class="recipe-sheet-page">
        <div class="recipe-sheet-column">
            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.Batch</h3>
                <div class="recipe-section-body">
                    <table class="recipe-table recipe-table-simple">
                        <tbody>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipe.Style"></label>
                                </td>
                                <td colspan="2" class="value">@Model.BrewRecipe.Style</td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="BrewBatch.Status"></label>
                                </td>
                                <td colspan="2">
                                    <select asp-for="BrewBatch.Status" asp-items="Html.GetEnumSelectList<BrewBatchStatus>()" class="form-select"></select>
                                    <span asp-validation-for="BrewBatch.Status" class="text-danger validation-message"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="BrewBatch.BatchSize"></label>
                                </td>
                                <td class="numeric">
                                    <input asp-for="BrewBatch.BatchSize" class="form-control input-number" />
                                    <span asp-validation-for="BrewBatch.BatchSize" class="text-danger validation-message"></span>
                                </td>
                                <td class="unit">L</td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="BrewBatch.BrewhouseEfficiency"></label>
                                </td>
                                <td class="numeric">
                                    <input asp-for="BrewBatch.BrewhouseEfficiency" class="form-control input-number" />
                                    <span asp-validation-for="BrewBatch.BrewhouseEfficiency" class="text-danger validation-message"></span>
                                </td>
                                <td class="unit">%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.Ingredients</h3>
                <div class="recipe-section-body">
                    <h4 class="recipe-subtitle">@Resource.Malt</h4>

                    <table class="recipe-table recipe-table-simple">
                        <thead>
                            <tr>
                                <th>@Resource.Name</th>
                                <th class="numeric">@Resource.Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.BrewRecipeVersion.MaltAdditions.Count; i++)
                            {
                                <tr class="maltAdditionRow" data-recipe-amount="@Model.BrewRecipeVersion.MaltAdditions[i].Amount">
                                    <td>@Model.BrewRecipeVersion.MaltAdditions[i].Name</td>
                                    <td class="numeric">
                                        <span class="maltAmount">@Model.BrewRecipeVersion.MaltAdditions[i].Amount</span> kg
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <h4 class="recipe-subtitle">@Resource.Hops</h4>

                    <table class="recipe-table recipe-table-simple">
                        <thead>
                            <tr>
                                <th>@Resource.Hop</th>
                                <th class="numeric">@Resource.AlphaAcid</th>
                                <th class="numeric">@Resource.Amount</th>
                            </tr>
                        </thead>
                        <tbody id="ingredientHops"></tbody>
                    </table>

                    <h4 class="recipe-subtitle">@Resource.Yeasts</h4>

                    <table class="recipe-table recipe-table-simple">
                        <thead>
                            <tr>
                                <th>@Resource.Yeast</th>
                                <th class="numeric">@Resource.Amount</th>
                                <th class="numeric">@Resource.Selected</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.BrewBatch.YeastAdditions.Count; i++)
                            {
                                <tr class="yeastAdditionRow"
                                    data-recipe-amount="@Model.BrewRecipeVersion.YeastAdditions.Single(y => y.Index == Model.BrewBatch.YeastAdditions[i].Index).Amount">

                                    <td>
                                        <input type="hidden" asp-for="BrewBatch.YeastAdditions[i].Index" />
                                        <input type="hidden" asp-for="BrewBatch.YeastAdditions[i].Name" />
                                        <input type="hidden" asp-for="BrewBatch.YeastAdditions[i].Unit" />
                                        <input type="hidden" asp-for="BrewBatch.YeastAdditions[i].Amount" class="yeastAmount" />

                                        @Model.BrewBatch.YeastAdditions[i].Name
                                    </td>
                                    <td class="numeric">
                                        <span class="yeastAmountDisplay">@Model.BrewBatch.YeastAdditions[i].Amount</span>
                                        @Model.BrewBatch.YeastAdditions[i].Unit
                                    </td>
                                    <td class="numeric">
                                        <input asp-for="BrewBatch.YeastAdditions[i].Selected" class="form-check-input" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="recipe-sheet-column">
            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.BrewingWater</h3>
                <div class="recipe-section-body">
                    <table class="recipe-key-values">
                        <tbody>
                            <tr>
                                <td>
                                    <label asp-for="BrewBatch.MashWaterPercentage"></label>
                                </td>
                                <td>
                                    <div class="recipe-input-with-unit">
                                        <input asp-for="BrewBatch.MashWaterPercentage" class="form-control input-number" />
                                        <span class="recipe-inline-unit">%</span>
                                    </div>
                                    <span asp-validation-for="BrewBatch.MashWaterPercentage" class="text-danger validation-message"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    @if (Model.BrewBatch.WaterAdditions.Count > 0)
                    {
                        <h4 class="recipe-subtitle">@Resource.WaterAdditions</h4>

                        <table class="recipe-table recipe-table-simple">
                            <thead>
                                <tr>
                                    <th>@Resource.Name</th>
                                    <th class="numeric">@Resource.Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.BrewBatch.WaterAdditions.Count; i++)
                                {
                                    var recipeWater = Model.BrewRecipeVersion.WaterAdditions
                                        .Single(w => w.Index == Model.BrewBatch.WaterAdditions[i].Index);

                                    <tr class="waterAdditionRow" data-recipe-amount="@recipeWater.Amount">
                                        <td>
                                            <input type="hidden" asp-for="BrewBatch.WaterAdditions[i].Index" />
                                            <input type="hidden" asp-for="BrewBatch.WaterAdditions[i].Name" />
                                            <input type="hidden" asp-for="BrewBatch.WaterAdditions[i].Type" />
                                            <input type="hidden" asp-for="BrewBatch.WaterAdditions[i].Unit" />
                                            @Model.BrewBatch.WaterAdditions[i].Type
                                        </td>
                                        <td class="numeric">
                                            <div class="recipe-input-with-unit">
                                                <input asp-for="BrewBatch.WaterAdditions[i].Amount" class="form-control input-number waterAmount" />
                                                <span class="recipe-inline-unit">@Model.BrewBatch.WaterAdditions[i].Unit</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>

            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.MashSchedule</h3>
                <div class="recipe-section-body">
                    <table class="recipe-table recipe-table-simple">
                        <thead>
                            <tr>
                                <th>@Resource.Step</th>
                                <th class="numeric">@Resource.Temperature</th>
                                <th class="numeric">@Resource.Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mashStep in Model.BrewRecipeVersion.MashSteps)
                            {
                                <tr>
                                    <td>@mashStep.Name</td>
                                    <td class="numeric">@mashStep.Temperature °C</td>
                                    <td class="numeric">@mashStep.Duration min</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.Boil</h3>
                <div class="recipe-section-body">
                    <table class="recipe-key-values">
                        <tbody>
                            <tr>
                                <td>@Resource.BoilDuration</td>
                                <td>@Model.BrewRecipeVersion.BoilDuration min</td>
                            </tr>
                        </tbody>
                    </table>

                    @if (Model.BrewBatch.Hops.Count > 0)
                    {
                        <h4 class="recipe-subtitle">@Resource.HopAdditions</h4>

                        <div class="recipe-table-wrap">
                            <table class="recipe-table">
                                <thead>
                                    <tr>
                                        <th>@Resource.Hop</th>
                                        <th class="numeric">@Resource.AlphaAcid [%]</th>
                                        <th class="numeric">@Resource.Amount [g]</th>
                                        <th class="numeric">@Resource.BoilDuration [min]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.BrewBatch.Hops.Count; i++)
                                    {
                                        var brewHop = Model.BrewBatch.Hops[i];
                                        var recipeHop = Model.BrewRecipeVersion.HopAdditions
                                            .Single(h => h.Id == brewHop.HopAdditionId);

                                        <tr class="hopsAdditionRow"
                                            data-recipe-name="@recipeHop.Name"
                                            data-recipe-amount="@recipeHop.Amount"
                                            data-recipe-alpha="@recipeHop.AlphaAcid"
                                            data-recipe-unit="@recipeHop.Unit">

                                            <td>
                                                <input type="hidden" asp-for="BrewBatch.Hops[i].HopAdditionId" />
                                                @recipeHop.Name
                                            </td>
                                            <td class="numeric">
                                                <input asp-for="BrewBatch.Hops[i].AlphaAcid" class="form-control input-number hopAlphaAcid" />
                                            </td>
                                            <td class="numeric">
                                                <span class="hopAmount"></span>
                                            </td>
                                            <td class="numeric">@recipeHop.Duration</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <h4 class="recipe-subtitle">@Resource.FiningAgents</h4>

                    <div class="batch-checks">
                        <div class="batch-check">
                            <input asp-for="BrewBatch.UseIrishMoss" class="form-check-input" />
                            <label asp-for="BrewBatch.UseIrishMoss"></label>
                        </div>
                        <div class="batch-check">
                            <input asp-for="BrewBatch.UseWhirlfloc" class="form-check-input" />
                            <label asp-for="BrewBatch.UseWhirlfloc"></label>
                        </div>
                        <div class="batch-check">
                            <input asp-for="BrewBatch.UseSilicaSol" class="form-check-input" />
                            <label asp-for="BrewBatch.UseSilicaSol"></label>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="recipe-footer-actions">
        <div class="secondary-actions">
            <a asp-page="./Index" class="btn btn-outline-secondary">@Resource.Back</a>
        </div>
        <div class="primary-actions">
            <button type="submit" class="btn btn-primary">@Resource.Create</button>
        </div>
    </div>
</form>

<input type="hidden" value="@Model.BrewRecipeVersion.BatchSize" id="RecipeBatchSize" />
<input type="hidden" value="@Model.BrewRecipeVersion.BrewhouseEfficiency" id="RecipeBrewhouseEfficiency" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $.validator.methods.number = function(value, element) {
            return this.optional(element)
                || /^-?\d+(,\d+)?$/.test(value);
        };

        const batchSizeInput = document.getElementById("BrewBatch_BatchSize");
        const brewhouseEfficiencyInput = document.getElementById("BrewBatch_BrewhouseEfficiency");

        const recipeBatchSize = parseDecimal(
            document.getElementById("RecipeBatchSize").value
        );

        const recipeBrewhouseEfficiency = parseDecimal(
            document.getElementById("RecipeBrewhouseEfficiency").value
        );

        batchSizeInput.addEventListener("input", updateBrewValues);
        brewhouseEfficiencyInput.addEventListener("input", updateBrewValues);

        document.querySelectorAll(".hopAlphaAcid").forEach(function(input) {
            input.addEventListener("input", updateBrewValues);
        });

        function parseDecimal(value) {
            if (value === null || value === undefined || value === "") {
                return NaN;
            }

            return parseFloat(
                value.toString().replace(",", ".")
            );
        }

        function formatDecimal(value) {
            return value
                .toFixed(2)
                .replace(".", ",");
        }

        function getBatchSizeFactor() {
            const targetBatchSize = parseDecimal(batchSizeInput.value);

            if (
                isNaN(recipeBatchSize)
                || isNaN(targetBatchSize)
                || recipeBatchSize === 0
            ) {
                return null;
            }

            return targetBatchSize / recipeBatchSize;
        }

        function updateMaltAmounts(batchSizeFactor) {
            const targetBrewhouseEfficiency = parseDecimal(
                brewhouseEfficiencyInput.value
            );

            if (
                isNaN(recipeBrewhouseEfficiency)
                || isNaN(targetBrewhouseEfficiency)
                || targetBrewhouseEfficiency === 0
            ) {
                return;
            }

            const efficiencyFactor =
                recipeBrewhouseEfficiency
                / targetBrewhouseEfficiency;

            document.querySelectorAll(".maltAdditionRow").forEach(function(row) {
                const recipeAmount = parseDecimal(row.dataset.recipeAmount);
                const amountDisplay = row.querySelector(".maltAmount");

                if (
                    isNaN(recipeAmount)
                    || !amountDisplay
                ) {
                    return;
                }

                const targetAmount =
                    recipeAmount
                    * batchSizeFactor
                    * efficiencyFactor;

                amountDisplay.textContent = formatDecimal(targetAmount);
            });
        }

        function updateHopAmounts(batchSizeFactor) {
            document.querySelectorAll(".hopsAdditionRow").forEach(function(row) {
                const recipeAmount = parseDecimal(row.dataset.recipeAmount);
                const recipeAlpha = parseDecimal(row.dataset.recipeAlpha);
                const actualAlphaInput = row.querySelector(".hopAlphaAcid");
                const amountDisplay = row.querySelector(".hopAmount");

                if (!actualAlphaInput || !amountDisplay) {
                    return;
                }

                const actualAlpha = parseDecimal(actualAlphaInput.value);

                if (
                    isNaN(recipeAmount)
                    || isNaN(recipeAlpha)
                    || isNaN(actualAlpha)
                    || actualAlpha === 0
                ) {
                    return;
                }

                const targetAmount =
                    recipeAmount
                    * batchSizeFactor
                    * (recipeAlpha / actualAlpha);

                amountDisplay.textContent = formatDecimal(targetAmount);
            });
        }

        function updateWaterAmounts(batchSizeFactor) {
            document.querySelectorAll(".waterAdditionRow").forEach(function(row) {
                const recipeAmount = parseDecimal(row.dataset.recipeAmount);
                const amountInput = row.querySelector(".waterAmount");

                if (
                    isNaN(recipeAmount)
                    || !amountInput
                ) {
                    return;
                }

                amountInput.value = formatDecimal(
                    recipeAmount * batchSizeFactor
                );
            });
        }

        function updateYeastAmounts(batchSizeFactor) {
            document.querySelectorAll(".yeastAdditionRow").forEach(function(row) {
                const recipeAmount = parseDecimal(row.dataset.recipeAmount);
                const amountInput = row.querySelector(".yeastAmount");
                const amountDisplay = row.querySelector(".yeastAmountDisplay");

                if (
                    isNaN(recipeAmount)
                    || !amountInput
                    || !amountDisplay
                ) {
                    return;
                }

                const targetAmount =
                    recipeAmount * batchSizeFactor;

                const formattedAmount =
                    formatDecimal(targetAmount);

                amountInput.value = formattedAmount;
                amountDisplay.textContent = formattedAmount;
            });
        }

        function updateBrewValues() {
            const batchSizeFactor = getBatchSizeFactor();

            if (batchSizeFactor === null) {
                return;
            }

            updateMaltAmounts(batchSizeFactor);
            updateHopAmounts(batchSizeFactor);
            updateWaterAmounts(batchSizeFactor);
            updateYeastAmounts(batchSizeFactor);
            updateIngredientHops();
        }

        function updateIngredientHops() {
            const groupedHops = new Map();

            document.querySelectorAll(".hopsAdditionRow").forEach(function(row) {
                const name = row.dataset.recipeName;
                const alphaAcidInput = row.querySelector(".hopAlphaAcid");
                const amountDisplay = row.querySelector(".hopAmount");
                const unit = row.dataset.recipeUnit;

                if (!alphaAcidInput || !amountDisplay) {
                    return;
                }

                const alphaAcid = parseDecimal(alphaAcidInput.value);
                const amount = parseDecimal(amountDisplay.textContent);

                if (isNaN(alphaAcid) || isNaN(amount)) {
                    return;
                }

                const key = `${name}|${alphaAcid}|${unit}`;

                if (!groupedHops.has(key)) {
                    groupedHops.set(key, {
                        name: name,
                        alphaAcid: alphaAcid,
                        amount: 0,
                        unit: unit
                    });
                }

                groupedHops.get(key).amount += amount;
            });

            const container = document.getElementById("ingredientHops");

            container.innerHTML = "";

            groupedHops.forEach(function(hop) {
                const row = document.createElement("tr");

                row.innerHTML = `
                            <td>${hop.name}</td>
                            <td class="numeric">${hop.alphaAcid} %</td>
                            <td class="numeric">${formatDecimal(hop.amount)} ${hop.unit}</td>
                        `;

                container.appendChild(row);
            });
        }

        updateBrewValues();
    </script>
}