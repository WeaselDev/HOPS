@page
@model HOPS.Pages.BrewRecipePages.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <div class="panel">
        <div class="panel-header">
            @Model.BrewRecipe.Name
        </div>

        <div class="panel-body">
            <dl>
                <dt>Style</dt>
                <dd>@Model.BrewRecipe.Style</dd>

                <dt>Version</dt>
                <dd>@Model.BrewRecipe.Versions.Last().Version</dd>

                <dt>Batch Size</dt>
                <dd>@Model.BrewRecipe.Versions.Last().BatchSize</dd>
            </dl>
        </div>
    </div>
    <form method="post">
        <input type="hidden" asp-for="BrewRecipe.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
