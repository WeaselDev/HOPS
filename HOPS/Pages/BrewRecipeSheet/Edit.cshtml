@page
@model HOPS.Pages.BrewRecipeSheet.EditModel
@using HOPS.Component
@using HOPS.Models
@using HOPS.Properties

@{
    ViewData["Title"] = Resource.EditRecipe;
    var beerColor = ColorHelper.EbcToHex(Model.BrewRecipeVersion.Color);
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="BrewRecipe.Id" />
    <input type="hidden" asp-for="BrewRecipeVersion.Id" />
    <input type="hidden" asp-for="BrewRecipeVersion.Version" />
    <input type="hidden" id="PreviousBatchSize" value="@Model.BrewRecipeVersion.BatchSize" />
    <input type="hidden" id="PreviousBrewhouseEfficiency" value="@Model.BrewRecipeVersion.BrewhouseEfficiency" />

    <header class="recipe-header" style="--beer-color: @beerColor;">
        <div class="recipe-title-row">
            <div class="flex-grow-1">
                <label asp-for="BrewRecipe.Name" class="recipe-metric-label"></label>
                <input asp-for="BrewRecipe.Name" class="form-control recipe-name-input" />
                <span asp-validation-for="BrewRecipe.Name" class="text-danger validation-message"></span>
            </div>
        </div>
    </header>

    <div id="recipeDetails" class="recipe-sheet-page">
        <div class="recipe-sheet-column">
            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.BaseData</h3>
                <div class="recipe-section-body">
                    <table class="recipe-table">
                        <tbody>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipe.Style"></label>
                                </td>
                                <td colspan="2">
                                    <input asp-for="BrewRecipe.Style" class="form-control" />
                                    <span asp-validation-for="BrewRecipe.Style" class="text-danger validation-message"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipeVersion.BatchSize"></label>
                                </td>
                                <td class="numeric">
                                    <input asp-for="BrewRecipeVersion.BatchSize" class="form-control input-number" />
                                    <span asp-validation-for="BrewRecipeVersion.BatchSize" class="text-danger validation-message"></span>
                                </td>
                                <td class="unit">L</td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipeVersion.BrewhouseEfficiency"></label>
                                </td>
                                <td class="numeric">
                                    <input asp-for="BrewRecipeVersion.BrewhouseEfficiency" class="form-control input-number" />
                                    <span asp-validation-for="BrewRecipeVersion.BrewhouseEfficiency" class="text-danger validation-message"></span>
                                </td>
                                <td class="unit">%</td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipeVersion.OriginalGravity"></label>
                                </td>
                                <td class="numeric">
                                    <input asp-for="BrewRecipeVersion.OriginalGravity" class="form-control input-number" />
                                    <span asp-validation-for="BrewRecipeVersion.OriginalGravity" class="text-danger validation-message"></span>
                                </td>
                                <td class="unit">°P</td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipeVersion.Bitterness"></label>
                                </td>
                                <td class="numeric">
                                    <input asp-for="BrewRecipeVersion.Bitterness" class="form-control input-number" />
                                    <span asp-validation-for="BrewRecipeVersion.Bitterness" class="text-danger validation-message"></span>
                                </td>
                                <td class="unit">IBU</td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipeVersion.Color"></label>
                                </td>
                                <td class="numeric">
                                    <input asp-for="BrewRecipeVersion.Color" class="form-control input-number" />
                                    <span asp-validation-for="BrewRecipeVersion.Color" class="text-danger validation-message"></span>
                                </td>
                                <td class="unit">EBC</td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipeVersion.EstimatedABV"></label>
                                </td>
                                <td class="numeric">
                                    <input asp-for="BrewRecipeVersion.EstimatedABV" class="form-control input-number" />
                                    <span asp-validation-for="BrewRecipeVersion.EstimatedABV" class="text-danger validation-message"></span>
                                </td>
                                <td class="unit">%</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="recipe-description-input">
                        <label asp-for="BrewRecipe.Description" class="recipe-metric-label"></label>
                        <input asp-for="BrewRecipe.Description" class="form-control" />
                        <span asp-validation-for="BrewRecipe.Description" class="text-danger validation-message"></span>
                    </div>
                </div>
            </section>

            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.GrainBill</h3>
                <div class="recipe-section-body">
                    <div class="recipe-table-wrap">
                        <table class="recipe-table">
                            <thead>
                                <tr>
                                    <th class="recipe-drag-column"></th>
                                    <th>@Resource.Malt</th>
                                    <th class="numeric">@Resource.Amount [kg]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="maltAdditions">
                                @for (int i = 0; i < Model.BrewRecipeVersion.MaltAdditions.Count; i++)
                                {
                                    <tr class="collection-row">
                                        <td class="recipe-drag-cell">
                                            <input type="hidden" asp-for="BrewRecipeVersion.MaltAdditions[i].Index" />
                                            <input type="hidden" asp-for="BrewRecipeVersion.MaltAdditions[i].Id" />
                                            <button type="button" class="recipe-drag-handle" title="@Resource.Move" aria-label="@Resource.Move">⠿</button>
                                        </td>
                                        <td>
                                            <input asp-for="BrewRecipeVersion.MaltAdditions[i].Name" class="form-control input-name" />
                                        </td>
                                        <td class="numeric">
                                            <div class="recipe-input-with-unit">
                                                <input asp-for="BrewRecipeVersion.MaltAdditions[i].Amount" class="form-control input-number scalable-amount malt-amount" />
                                                <!--<span class="recipe-inline-unit">kg</span>-->
                                            </div>
                                        </td>
                                        <td class="recipe-actions-cell">
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="@Resource.Delete">×</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button type="button" class="btn btn-sm btn-outline-secondary recipe-add-button add-row" data-collection="MaltAdditions">+ @Resource.GrainBill</button>
                </div>
            </section>

            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.Hops</h3>
                <div class="recipe-section-body">
                    <table class="recipe-table">
                        <thead>
                            <tr>
                                <th>@Resource.Hop</th>
                                <th class="numeric">@Resource.AlphaAcid [%]</th>
                                <th class="numeric">@Resource.Amount [g]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hop in Model.BrewRecipeVersion.HopAdditions
                            .GroupBy(h => new { h.Name, h.AlphaAcid })
                            .Select(g => new
                            {
                                g.Key.Name,
                                g.Key.AlphaAcid,
                                Amount = g.Sum(h => h.Amount)
                            }))
                            {
                                <tr>
                                    <td>@hop.Name</td>
                                    <td class="numeric">@hop.AlphaAcid</td>
                                    <td class="numeric">@hop.Amount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.OtherIngredients</h3>
                <div class="recipe-section-body">
                    @if (Model.BrewRecipeVersion.FermentationAdditions.Count > 0)
                    {
                        <table class="recipe-table">
                            <tbody>
                                @foreach (var addition in Model.BrewRecipeVersion.FermentationAdditions
                                    .GroupBy(a => new { a.Name, a.Unit })
                                    .Select(g => new
                                    {
                                        g.Key.Name,
                                        g.Key.Unit,
                                        Amount = g.Sum(a => a.Amount)
                                    }))
                                {
                                    <tr>
                                        <td>@addition.Name</td>
                                        <td class="numeric">@addition.Amount @addition.Unit</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <span class="text-muted">@Resource.NoFermentationAdditions</span>
                    }
                </div>
            </section>

            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.Yeast</h3>
                <div class="recipe-section-body">
                    <div class="recipe-table-wrap">
                        <table class="recipe-table">
                            <thead>
                                <tr>
                                    <th class="recipe-drag-column"></th>
                                    <th>@Resource.Yeast</th>
                                    <th class="numeric">@Resource.Amount</th>
                                    <th>@Resource.Unit</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="yeastAdditions">
                                @for (int i = 0; i < Model.BrewRecipeVersion.YeastAdditions.Count; i++)
                                {
                                    <tr class="collection-row">
                                        <td class="recipe-drag-cell">
                                            <input type="hidden" asp-for="BrewRecipeVersion.YeastAdditions[i].Index" />
                                            <input type="hidden" asp-for="BrewRecipeVersion.YeastAdditions[i].Id" />
                                            <button type="button" class="recipe-drag-handle" title="@Resource.Move" aria-label="@Resource.Move">⠿</button>
                                        </td>
                                        <td>
                                            <input asp-for="BrewRecipeVersion.YeastAdditions[i].Name" class="form-control input-name" />
                                        </td>
                                        <td class="numeric">
                                            <input asp-for="BrewRecipeVersion.YeastAdditions[i].Amount" class="form-control input-number" />
                                        </td>
                                        <td>
                                            <select asp-for="BrewRecipeVersion.YeastAdditions[i].Unit" class="form-select input-unit">
                                                <option value="stck">stck</option>
                                                <option value="g">g</option>
                                            </select>
                                        </td>
                                        <td class="recipe-actions-cell">
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="@Resource.Delete">×</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button type="button" class="btn btn-sm btn-outline-secondary recipe-add-button add-row" data-collection="YeastAdditions">+ @Resource.Yeast</button>
                </div>
            </section>
        </div>

        <div class="recipe-sheet-column">
            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.BrewingWater</h3>
                <div class="recipe-section-body">
                    <div class="recipe-fields">
                        <div class="recipe-field recipe-field-narrow">
                            <label asp-for="BrewRecipeVersion.TotalWater"></label>
                            <div class="recipe-input-with-unit">
                                <input asp-for="BrewRecipeVersion.TotalWater" class="form-control scalable-amount" />
                                <span class="recipe-inline-unit">L</span>
                            </div>
                            <span asp-validation-for="BrewRecipeVersion.TotalWater" class="text-danger validation-message"></span>
                        </div>
                        <div class="recipe-field recipe-field-narrow">
                            <label asp-for="BrewRecipeVersion.MashWaterPercentage"></label>
                            <div class="recipe-input-with-unit">
                                <input asp-for="BrewRecipeVersion.MashWaterPercentage" class="form-control" />
                                <span class="recipe-inline-unit">%</span>
                            </div>
                            <span asp-validation-for="BrewRecipeVersion.MashWaterPercentage" class="text-danger validation-message"></span>
                        </div>
                    </div>

                    <h4 class="recipe-subtitle">@Resource.WaterAdditions</h4>

                    <div class="recipe-table-wrap">
                        <table class="recipe-table">
                            <thead>
                                <tr>
                                    <th class="recipe-drag-column"></th>
                                    <th>@Resource.WaterAddition</th>
                                    <th class="numeric">@Resource.Amount</th>
                                    <th class="numeric">@Resource.Unit</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="waterAdditions">
                                @for (int i = 0; i < Model.BrewRecipeVersion.WaterAdditions.Count; i++)
                                {
                                    <tr class="collection-row">
                                        <td class="recipe-drag-cell">
                                            <input type="hidden" asp-for="BrewRecipeVersion.WaterAdditions[i].Index" />
                                            <input type="hidden" asp-for="BrewRecipeVersion.WaterAdditions[i].Id" />
                                            <button type="button" class="recipe-drag-handle" title="@Resource.Move" aria-label="@Resource.Move">⠿</button>
                                        </td>
                                        <td>
                                            <select asp-for="BrewRecipeVersion.WaterAdditions[i].Type" asp-items="Html.GetEnumSelectList<WaterAdditionType>()" class="form-select"></select>
                                        </td>
                                        <td class="numeric">
                                            <input asp-for="BrewRecipeVersion.WaterAdditions[i].Amount" class="form-control input-number scalable-amount" />
                                        </td>
                                        <td class="numeric">
                                            <input asp-for="BrewRecipeVersion.WaterAdditions[i].Unit" class="form-control input-number" />
                                        </td>
                                        <td class="recipe-actions-cell">
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="@Resource.Delete">×</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button type="button" class="btn btn-sm btn-outline-secondary recipe-add-button add-row" data-collection="WaterAdditions">+ @Resource.WaterAddition</button>
                </div>
            </section>

            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.MashSchedule</h3>
                <div class="recipe-section-body">
                    <div class="recipe-table-wrap">
                        <table class="recipe-table">
                            <thead>
                                <tr>
                                    <th class="recipe-drag-column"></th>
                                    <th>@Resource.Step</th>
                                    <th class="numeric">@Resource.Temperature [°C]</th>
                                    <th class="numeric">@Resource.Time [min]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="mashSteps">
                                @for (int i = 0; i < Model.BrewRecipeVersion.MashSteps.Count; i++)
                                {
                                    <tr class="collection-row">
                                        <td class="recipe-drag-cell">
                                            <input type="hidden" asp-for="BrewRecipeVersion.MashSteps[i].Index" />
                                            <input type="hidden" asp-for="BrewRecipeVersion.MashSteps[i].Id" />
                                            <button type="button" class="recipe-drag-handle" title="@Resource.Move" aria-label="@Resource.Move">⠿</button>
                                        </td>
                                        <td>
                                            <input asp-for="BrewRecipeVersion.MashSteps[i].Name" class="form-control input-name" />
                                        </td>
                                        <td class="numeric">
                                            <div class="recipe-input-with-unit">
                                                <input asp-for="BrewRecipeVersion.MashSteps[i].Temperature" class="form-control input-number" />
                                                <!--<span class="recipe-inline-unit">°C</span>-->
                                            </div>
                                        </td>
                                        <td class="numeric">
                                            <div class="recipe-input-with-unit">
                                                <input asp-for="BrewRecipeVersion.MashSteps[i].Duration" class="form-control input-number" type="text" />
                                                <!--<span class="recipe-inline-unit">min</span>-->
                                            </div>
                                        </td>
                                        <td class="recipe-actions-cell">
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="@Resource.Delete">×</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button type="button" class="btn btn-sm btn-outline-secondary recipe-add-button add-row" data-collection="MashSteps">+ @Resource.Step</button>
                </div>
            </section>

            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.Boil</h3>
                <div class="recipe-section-body">
                    <table class="recipe-key-values">
                        <tbody>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipeVersion.BoilDuration"></label>
                                </td>
                                <td>
                                    <div class="recipe-input-with-unit">
                                        <input asp-for="BrewRecipeVersion.BoilDuration" class="form-control input-number" />
                                        <span class="recipe-inline-unit">min</span>
                                    </div>
                                    <span asp-validation-for="BrewRecipeVersion.BoilDuration" class="text-danger validation-message"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <h4 class="recipe-subtitle">@Resource.HopAdditions</h4>

                    <div class="recipe-table-wrap">
                        <table class="recipe-table">
                            <thead>
                                <tr>
                                    <th class="recipe-drag-column"></th>
                                    <th>@Resource.Hops</th>
                                    <th class="numeric">@Resource.AlphaAcid [%]</th>
                                    <th class="numeric">@Resource.Amount [g]</th>
                                    <th class="numeric">@Resource.Duration [min]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="hopAdditions">
                                @for (int i = 0; i < Model.BrewRecipeVersion.HopAdditions.Count; i++)
                                {
                                    <tr class="collection-row">
                                        <td class="recipe-drag-cell">
                                            <input type="hidden" asp-for="BrewRecipeVersion.HopAdditions[i].Index" />
                                            <input type="hidden" asp-for="BrewRecipeVersion.HopAdditions[i].Id" />
                                            <button type="button" class="recipe-drag-handle" title="@Resource.Move" aria-label="@Resource.Move">⠿</button>
                                        </td>
                                        <td>
                                            <input asp-for="BrewRecipeVersion.HopAdditions[i].Name" class="form-control input-name" />
                                        </td>
                                        <td class="numeric">
                                            <div class="recipe-input-with-unit">
                                                <input asp-for="BrewRecipeVersion.HopAdditions[i].AlphaAcid" class="form-control input-number" />
                                                <!--<span class="recipe-inline-unit">%</span>-->
                                            </div>
                                        </td>
                                        <td class="numeric">
                                            <div class="recipe-input-with-unit">
                                                <input asp-for="BrewRecipeVersion.HopAdditions[i].Amount" class="form-control input-number scalable-amount" />
                                                <!--<span class="recipe-inline-unit">g</span>-->
                                            </div>
                                        </td>
                                        <td class="numeric">
                                            <div class="recipe-input-with-unit">
                                                <input asp-for="BrewRecipeVersion.HopAdditions[i].Duration" class="form-control input-number" type="text" />
                                                <!--<span class="recipe-inline-unit">min</span>-->
                                            </div>
                                        </td>
                                        <td class="recipe-actions-cell">
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="@Resource.Delete">×</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button type="button" class="btn btn-sm btn-outline-secondary recipe-add-button add-row" data-collection="HopAdditions">+ @Resource.HopAdditions</button>

                    <h4 class="recipe-subtitle">@Resource.FiningAgents</h4>

                    <div class="form-check">
                        <input asp-for="BrewRecipeVersion.UseIrishMoss" class="form-check-input" />
                        <label asp-for="BrewRecipeVersion.UseIrishMoss" class="form-check-label"></label>
                    </div>

                    <div class="form-check">
                        <input asp-for="BrewRecipeVersion.UseWhirlfloc" class="form-check-input" />
                        <label asp-for="BrewRecipeVersion.UseWhirlfloc" class="form-check-label"></label>
                    </div>

                    <div class="form-check">
                        <input asp-for="BrewRecipeVersion.UseSilicaSol" class="form-check-input" />
                        <label asp-for="BrewRecipeVersion.UseSilicaSol" class="form-check-label"></label>
                    </div>
                </div>
            </section>

            <section class="recipe-sheet-section">
                <h3 class="recipe-section-title">@Resource.FermentationAndAging</h3>
                <div class="recipe-section-body">
                    <table class="recipe-key-values">
                        <tbody>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipeVersion.FermentationTemperature"></label>
                                </td>
                                <td>
                                    <div class="recipe-input-with-unit">
                                        <input asp-for="BrewRecipeVersion.FermentationTemperature" class="form-control input-number" />
                                        <span class="recipe-inline-unit">°C</span>
                                    </div>
                                    <span asp-validation-for="BrewRecipeVersion.FermentationTemperature" class="text-danger validation-message"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipeVersion.ApparantAttenuation"></label>
                                </td>
                                <td>
                                    <div class="recipe-input-with-unit">
                                        <input asp-for="BrewRecipeVersion.ApparantAttenuation" class="form-control input-number" />
                                        <span class="recipe-inline-unit">%</span>
                                    </div>
                                    <span asp-validation-for="BrewRecipeVersion.ApparantAttenuation" class="text-danger validation-message"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label asp-for="BrewRecipeVersion.Carbonation"></label>
                                </td>
                                <td>
                                    <div class="recipe-input-with-unit">
                                        <input asp-for="BrewRecipeVersion.Carbonation" class="form-control input-number" />
                                        <span class="recipe-inline-unit">g CO2/L</span>
                                    </div>
                                    <span asp-validation-for="BrewRecipeVersion.Carbonation" class="text-danger validation-message"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    @Resource.MaturationTime
                                </td>
                                <td>
                                    <div class="recipe-input-with-unit">
                                        <input asp-for="BrewRecipe.Versions[0].MaturationWeeksMin" class="form-control" />
                                        <span class="recipe-inline-unit">-</span>
                                        <input asp-for="BrewRecipe.Versions[0].MaturationWeeksMax" class="form-control" />
                                        <span class="recipe-inline-unit">@Resource.Weeks</span>
                                    </div>

                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <h4 class="recipe-subtitle">@Resource.FermentationAdditions</h4>

                    <div class="recipe-table-wrap">
                        <table class="recipe-table">
                            <thead>
                                <tr>
                                    <th class="recipe-drag-column"></th>
                                    <th>@Resource.Addition</th>
                                    <th class="numeric">@Resource.Amount</th>
                                    <th class="numeric">@Resource.Unit</th>
                                    <th class="numeric">@Resource.Time [min]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="fermentationAdditions">
                                @for (int i = 0; i < Model.BrewRecipeVersion.FermentationAdditions.Count; i++)
                                {
                                    <tr class="collection-row">
                                        <td class="recipe-drag-cell">
                                            <input type="hidden" asp-for="BrewRecipeVersion.FermentationAdditions[i].Index" />
                                            <input type="hidden" asp-for="BrewRecipeVersion.FermentationAdditions[i].Id" />
                                            <button type="button" class="recipe-drag-handle" title="@Resource.Move" aria-label="@Resource.Move">⠿</button>
                                        </td>
                                        <td>
                                            <input asp-for="BrewRecipeVersion.FermentationAdditions[i].Name" class="form-control input-name" />
                                        </td>
                                        <td class="numeric">
                                            <input asp-for="BrewRecipeVersion.FermentationAdditions[i].Amount" class="form-control input-number scalable-amount" />
                                        </td>
                                        <td class="numeric">
                                            <input asp-for="BrewRecipeVersion.FermentationAdditions[i].Unit" class="form-control input-number" />
                                        </td>
                                        <td class="numeric">
                                            <input asp-for="BrewRecipeVersion.FermentationAdditions[i].Time" class="form-control input-number" />
                                        </td>
                                        <td class="recipe-actions-cell">
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="@Resource.Delete">×</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <button type="button" class="btn btn-sm btn-outline-secondary recipe-add-button add-row" data-collection="FermentationAdditions">+ @Resource.FermentationAddition</button>
                </div>
            </section>
        </div>
    </div>

    <div class="recipe-footer-actions">
        <div class="secondary-actions">
            <a asp-page="./Details" asp-route-id="@Model.BrewRecipe.Id" asp-route-version="@Model.BrewRecipeVersion.Version" class="btn btn-outline-secondary">@Resource.Cancle</a>
        </div>
        <div class="primary-actions">
            <button type="submit" class="btn btn-primary">@Resource.Save</button>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $.validator.methods.number = function(value, element) {
            return this.optional(element) || /^-?\d+(,\d+)?$/.test(value);
        };

        const prefix = "BrewRecipeVersion";

        const configs = {
            WaterAdditions: {
                fields: [
                    {
                        n: "Type",
                        t: "select",
                        options: [
                            ["0", "DistilledWater"],
                            ["1", "LacticAcid"],
                            ["2", "CalciumChloride"],
                            ["3", "CalciumSulfate"],
                            ["4", "MagnesiumSulfate"]
                        ]
                    },
                    { n: "Amount" },
                    { n: "Unit" }
                ]
            },
            MaltAdditions: {
                fields: [
                    { n: "Name" },
                    { n: "Amount", unit: "kg", cls: "scalable-amount malt-amount" }
                ],
                fixedUnit: "kg"
            },
            MashSteps: {
                fields: [
                    { n: "Name" },
                    { n: "Temperature", unit: "°C" },
                    { n: "Duration", unit: "min" }
                ]
            },
            HopAdditions: {
                fields: [
                    { n: "Name" },
                    { n: "AlphaAcid", unit: "%" },
                    { n: "Amount", unit: "g", cls: "scalable-amount" },
                    { n: "Duration", unit: "min" }
                ],
                fixedUnit: "g"
            },
            YeastAdditions: {
                fields: [
                    { n: "Name" },
                    { n: "Amount" },
                    {
                        n: "Unit",
                        t: "select",
                        options: [
                            ["stck", "stck"],
                            ["g", "g"]
                        ]
                    }
                ]
            },
            FermentationAdditions: {
                fields: [
                    { n: "Name" },
                    { n: "Amount", cls: "scalable-amount" },
                    { n: "Unit" },
                    { n: "Time" }
                ]
            }
        };

        function inputHtml(collection, index, field) {
            const name = `${prefix}.${collection}[${index}].${field.n}`;

            if (field.t === "select") {
                const options = field.options
                    .map(option => `<option value="${option[0]}">${option[1]}</option>`)
                    .join("");

                const inputClass = field.n === "Unit" ? "input-unit" : "";

                return `<select name="${name}" class="form-select ${inputClass}">${options}</select>`;
            }

            const isTextField = field.n === "Name" || field.n === "Description";
            const inputClass = isTextField ? "input-name" : "input-number";
            const unit = field.unit
                ? `<span class="recipe-inline-unit">${field.unit}</span>`
                : "";

            if (isTextField) {
                return `<input name="${name}" class="form-control ${inputClass} ${field.cls || ""}" type="text" />`;
            }

            return `<div class="recipe-input-with-unit"><input name="${name}" class="form-control ${inputClass} ${field.cls || ""}" type="text" />${unit}</div>`;
        }

        function getCollectionName(tbody) {
            return Object.keys(configs).find(collection => {
                const id = collection[0].toLowerCase() + collection.slice(1);
                return tbody.id === id;
            });
        }

        function reindex(container, collection) {
            [...container.querySelectorAll(":scope > tr")].forEach((row, index) => {
                row.querySelectorAll("[name]").forEach(element => {
                    element.name = element.name.replace(
                        new RegExp(`${collection}\\[\\d+\\]`),
                        `${collection}[${index}]`
                    );
                });

                row.querySelectorAll("[id]").forEach(element => {
                    element.id = element.id.replace(
                        new RegExp(`${collection}_\\d+__`),
                        `${collection}_${index}__`
                    );
                });

                row.querySelectorAll("label[for]").forEach(element => {
                    element.htmlFor = element.htmlFor.replace(
                        new RegExp(`${collection}_\\d+__`),
                        `${collection}_${index}__`
                    );
                });

                const indexInput = row.querySelector('input[name$=".Index"]');

                if (indexInput) {
                    indexInput.value = index + 1;
                }
            });
        }

        function createRow(collection, index) {
            const config = configs[collection];
            const row = document.createElement("tr");

            row.className = "collection-row";

            const fixedUnit = config.fixedUnit
                ? `<input type="hidden" name="${prefix}.${collection}[${index}].Unit" value="${config.fixedUnit}" />`
                : "";

            const fields = config.fields
                .map(field => {
                    const cellClass = field.n === "Name" || field.n === "Description"
                        ? ""
                        : "numeric";

                    return `<td class="${cellClass}">${inputHtml(collection, index, field)}</td>`;
                })
                .join("");

            row.innerHTML = `
                <td class="recipe-drag-cell">
                    <input type="hidden" name="${prefix}.${collection}[${index}].Index" value="${index + 1}" />
                    ${fixedUnit}
                    <button type="button" class="recipe-drag-handle" title="@Resource.Move" aria-label="@Resource.Move">⠿</button>
                </td>
                ${fields}
                <td class="recipe-actions-cell">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-row" title="@Resource.Delete">×</button>
                </td>
            `;

            return row;
        }

        function ensureFixedUnit(collection, unit) {
            const tbodyId = collection[0].toLowerCase() + collection.slice(1);
            const tbody = document.getElementById(tbodyId);

            if (!tbody) {
                return;
            }

            tbody.querySelectorAll(".collection-row").forEach((row, index) => {
                if (row.querySelector('input[name$=".Unit"]')) {
                    return;
                }

                row.insertAdjacentHTML(
                    "afterbegin",
                    `<input type="hidden" name="${prefix}.${collection}[${index}].Unit" value="${unit}" />`
                );
            });
        }

        document.addEventListener("click", event => {
            const addButton = event.target.closest(".add-row");

            if (addButton) {
                const collection = addButton.dataset.collection;
                const tbodyId = collection[0].toLowerCase() + collection.slice(1);
                const tbody = document.getElementById(tbodyId);

                if (!tbody) {
                    return;
                }

                const index = tbody.children.length;

                tbody.appendChild(createRow(collection, index));
                reindex(tbody, collection);

                return;
            }

            const removeButton = event.target.closest(".remove-row");

            if (!removeButton) {
                return;
            }

            const row = removeButton.closest(".collection-row");

            if (!row) {
                return;
            }

            const tbody = row.parentElement;
            const collection = getCollectionName(tbody);

            if (!collection) {
                return;
            }

            row.remove();
            reindex(tbody, collection);
        });

        let draggedRow = null;

        document.addEventListener("pointerdown", event => {
            const handle = event.target.closest(".recipe-drag-handle");

            if (!handle) {
                return;
            }

            const row = handle.closest(".collection-row");

            if (!row) {
                return;
            }

            row.draggable = true;
        });

        document.addEventListener("pointerup", () => {
            document.querySelectorAll(".collection-row[draggable='true']").forEach(row => {
                if (row !== draggedRow) {
                    row.draggable = false;
                }
            });
        });

        document.addEventListener("dragstart", event => {
            const row = event.target.closest(".collection-row");

            if (!row || !row.draggable) {
                return;
            }

            draggedRow = row;
            draggedRow.classList.add("recipe-row-dragging");

            event.dataTransfer.effectAllowed = "move";
            event.dataTransfer.setData("text/plain", "");
        });

        document.addEventListener("dragover", event => {
            if (!draggedRow) {
                return;
            }

            const targetRow = event.target.closest(".collection-row");

            if (!targetRow || targetRow === draggedRow) {
                return;
            }

            const sourceBody = draggedRow.parentElement;
            const targetBody = targetRow.parentElement;

            if (sourceBody !== targetBody) {
                return;
            }

            event.preventDefault();

            const bounds = targetRow.getBoundingClientRect();
            const insertAfter = event.clientY > bounds.top + bounds.height / 2;

            if (insertAfter) {
                targetRow.after(draggedRow);
            } else {
                targetRow.before(draggedRow);
            }
        });

        document.addEventListener("dragend", () => {
            if (!draggedRow) {
                return;
            }

            const tbody = draggedRow.parentElement;
            const collection = getCollectionName(tbody);

            draggedRow.classList.remove("recipe-row-dragging");
            draggedRow.draggable = false;

            if (collection) {
                reindex(tbody, collection);
            }

            draggedRow = null;
        });

        ensureFixedUnit("MaltAdditions", "kg");
        ensureFixedUnit("HopAdditions", "g");

        const batchSizeInput = document.getElementById("BrewRecipeVersion_BatchSize");
        const efficiencyInput = document.getElementById("BrewRecipeVersion_BrewhouseEfficiency");
        const previousBatch = document.getElementById("PreviousBatchSize");
        const previousEfficiency = document.getElementById("PreviousBrewhouseEfficiency");

        function num(value) {
            return parseFloat(value.replace(",", "."));
        }

        function updateRecipeAmounts() {
            const previousBatchSize = num(previousBatch.value);
            const currentBatchSize = num(batchSizeInput.value);
            const previousBrewhouseEfficiency = num(previousEfficiency.value);
            const currentBrewhouseEfficiency = num(efficiencyInput.value);

            if (
                !isNaN(previousBatchSize) &&
                !isNaN(currentBatchSize) &&
                previousBatchSize !== 0
            ) {
                const factor = currentBatchSize / previousBatchSize;

                document.querySelectorAll(".scalable-amount").forEach(input => {
                    const value = num(input.value);

                    if (!isNaN(value)) {
                        input.value = (value * factor).toFixed(2).replace(".", ",");
                    }
                });
            }

            if (
                !isNaN(previousBrewhouseEfficiency) &&
                !isNaN(currentBrewhouseEfficiency) &&
                currentBrewhouseEfficiency !== 0
            ) {
                const factor = previousBrewhouseEfficiency / currentBrewhouseEfficiency;

                document.querySelectorAll(".malt-amount").forEach(input => {
                    const value = num(input.value);

                    if (!isNaN(value)) {
                        input.value = (value * factor).toFixed(2).replace(".", ",");
                    }
                });
            }

            previousBatch.value = batchSizeInput.value;
            previousEfficiency.value = efficiencyInput.value;
        }

        batchSizeInput.addEventListener("change", updateRecipeAmounts);
        efficiencyInput.addEventListener("change", updateRecipeAmounts);
    </script>
}